POSTGRES_DB=seedshop_template
POSTGRES_USER=seedshop_template
POSTGRES_PASSWORD=replace-with-random-postgres-password

DATABASE_URL=postgresql://seedshop_template:replace-with-random-postgres-password@postgres:5432/seedshop_template
DOMAIN=shop.example.ru
SITE_URL=https://shop.example.ru
NEXT_PUBLIC_SITE_URL=https://shop.example.ru
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

ADMIN_AUTH_SECRET=replace-with-long-random-secret
ORDER_ACCESS_SECRET=replace-with-another-long-random-secret
CRON_SECRET=replace-with-a-third-long-random-secret

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional email notifications. Leave either value empty to disable them.
EMAIL_FROM=
RESEND_API_KEY=

# Optional Telegram notifications. Leave both values empty to disable them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SELLER_CHAT_ID=

# Optional analytics. The storefront works without it.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Host-side backup policy used by deploy/backup-postgres.sh.
BACKUP_DIR=/var/backups/seedshop-template
BACKUP_RETENTION_DAYS=14
# Example: remote-name:seedshop-template/postgres
RCLONE_REMOTE=
